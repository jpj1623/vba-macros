Sub FindNonDrivingCells()

    Dim masterWs As Worksheet
    On Error Resume Next
    Set masterWs = ThisWorkbook.Sheets("Master")
    On Error GoTo 0

    If masterWs Is Nothing Then
        MsgBox "Master sheet not found.", vbCritical
        Exit Sub
    End If

    Dim rawPath      As String
    Dim monitorSheet As String
    Dim monitorAddr  As String
    Dim testSheet    As String
    Dim testAddr     As String

    rawPath      = Trim(Replace(CStr(masterWs.Range("C2").Value), "/", "\"))
    monitorSheet = Trim(CStr(masterWs.Range("C3").Value))
    monitorAddr  = Trim(CStr(masterWs.Range("C4").Value))
    testSheet    = Trim(CStr(masterWs.Range("C5").Value))
    testAddr     = Trim(CStr(masterWs.Range("C6").Value))

    If rawPath = "" Or monitorSheet = "" Or monitorAddr = "" Or testSheet = "" Or testAddr = "" Then
        MsgBox "Please fill in all five inputs in the Master sheet (C2:C6).", vbExclamation
        Exit Sub
    End If

    If Dir(rawPath) = "" Then
        MsgBox "File not found:" & vbCrLf & rawPath, vbCritical
        Exit Sub
    End If

    Dim targetWb    As Workbook
    Dim alreadyOpen As Boolean
    alreadyOpen = False

    Dim wb As Workbook
    For Each wb In Application.Workbooks
        If LCase(wb.FullName) = LCase(rawPath) Then
            Set targetWb = wb
            alreadyOpen = True
            Exit For
        End If
    Next wb

    If Not alreadyOpen Then
        Set targetWb = Workbooks.Open(rawPath)
    End If

    Dim wsMonitor As Worksheet
    Dim wsTest    As Worksheet

    On Error Resume Next
    Set wsMonitor = targetWb.Sheets(monitorSheet)
    Set wsTest    = targetWb.Sheets(testSheet)
    On Error GoTo 0

    If wsMonitor Is Nothing Then
        MsgBox "Sheet '" & monitorSheet & "' not found in the target file.", vbCritical
        If Not alreadyOpen Then targetWb.Close False
        Exit Sub
    End If

    If wsTest Is Nothing Then
        MsgBox "Sheet '" & testSheet & "' not found in the target file.", vbCritical
        If Not alreadyOpen Then targetWb.Close False
        Exit Sub
    End If

    Dim monitorRange As Range
    Dim testRange    As Range

    On Error Resume Next
    Set monitorRange = wsMonitor.Range(monitorAddr)
    Set testRange    = wsTest.Range(testAddr)
    On Error GoTo 0

    If monitorRange Is Nothing Then
        MsgBox "Invalid monitor range: " & monitorAddr, vbCritical
        If Not alreadyOpen Then targetWb.Close False
        Exit Sub
    End If

    If testRange Is Nothing Then
        MsgBox "Invalid test range: " & testAddr, vbCritical
        If Not alreadyOpen Then targetWb.Close False
        Exit Sub
    End If

    Dim mRows As Long, mCols As Long
    mRows = monitorRange.Rows.Count
    mCols = monitorRange.Columns.Count

    Dim baseline() As Variant
    Dim afterDel() As Variant
    ReDim baseline(1 To mRows, 1 To mCols)
    ReDim afterDel(1 To mRows, 1 To mCols)

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    ' ── Capture baseline with CalculateFull to ensure clean starting state ──
    Application.CalculateFull
    Dim i As Long, j As Long
    For i = 1 To mRows
        For j = 1 To mCols
            baseline(i, j) = monitorRange.Cells(i, j).Value
        Next j
    Next i

    testRange.Interior.ColorIndex = xlNone

    Dim cell            As Range
    Dim hasFormula      As Boolean
    Dim savedFormula    As String
    Dim savedValue      As Variant
    Dim changed         As Boolean
    Dim restoreFailed   As Boolean
    Dim failedCells     As String
    Dim cellCount       As Long
    Dim totalCells      As Long

    totalCells = testRange.Cells.Count

    For Each cell In testRange.Cells

        cellCount = cellCount + 1
        Application.StatusBar = "Analysing cell " & cellCount & " of " & totalCells & " (" & cell.Address & ")"

        ' Blank cells can't drive anything
        If cell.Formula = "" Then
            cell.Interior.Color = RGB(255, 105, 105)
            GoTo NextCell
        End If

        ' ── Save original content ───────────────────────────────────────────
        hasFormula = (Left(cell.Formula, 1) = "=")
        If hasFormula Then
            savedFormula = cell.Formula
        Else
            savedValue = cell.Value
        End If

        ' ── Delete and do a full recalc ─────────────────────────────────────
        cell.ClearContents
        Application.CalculateFull

        ' ── Snapshot monitor range after deletion ───────────────────────────
        For i = 1 To mRows
            For j = 1 To mCols
                afterDel(i, j) = monitorRange.Cells(i, j).Value
            Next j
        Next i

        ' ── Compare ─────────────────────────────────────────────────────────
        changed = False
        For i = 1 To mRows
            For j = 1 To mCols
                If CStr(baseline(i, j)) <> CStr(afterDel(i, j)) Then
                    changed = True
                    Exit For
                End If
            Next j
            If changed Then Exit For
        Next i

        ' ── Restore with error handling ─────────────────────────────────────
        restoreFailed = False
        On Error Resume Next
        If hasFormula Then
            cell.Formula = savedFormula
        Else
            cell.Value = savedValue
        End If

        ' Verify restore actually worked
        If Err.Number <> 0 Then
            restoreFailed = True
            Err.Clear
        End If
        On Error GoTo 0

        ' Double-check: if cell is still empty after restore, flag it
        If cell.Formula = "" Then restoreFailed = True

        If restoreFailed Then
            failedCells = failedCells & cell.Address & " "
            cell.Interior.Color = RGB(255, 200, 0)  ' amber = restore failed, result unreliable
            GoTo NextCell
        End If

        ' ── Full recalc to re-settle the model ──────────────────────────────
        Application.CalculateFull

        ' ── Re-snapshot baseline to neutralise volatile functions ────────────
        For i = 1 To mRows
            For j = 1 To mCols
                baseline(i, j) = monitorRange.Cells(i, j).Value
            Next j
        Next i

        If Not changed Then
            cell.Interior.Color = RGB(255, 105, 105)
        End If

NextCell:
    Next cell

    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    Application.StatusBar = False

    targetWb.Save

    Dim msg As String
    msg = "Done! Red cells in '" & testSheet & "'!" & testAddr & _
          " have no effect on '" & monitorSheet & "'!" & monitorAddr & "."

    If failedCells <> "" Then
        msg = msg & vbCrLf & vbCrLf & _
              "WARNING: The following cells could not be restored and are highlighted amber " & _
              "(array formulas, table references, or external links may need manual review):" & _
              vbCrLf & failedCells
    End If

    MsgBox msg, vbInformation

End Sub
