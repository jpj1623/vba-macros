Sub FindNonDrivingCells()

    Dim checkerWs As Worksheet
    On Error Resume Next
    Set checkerWs = ThisWorkbook.Sheets("Dependency Checker")
    On Error GoTo 0

    If checkerWs Is Nothing Then
        MsgBox "Sheet 'Dependency Checker' not found in this workbook.", vbCritical
        Exit Sub
    End If

    Dim rawPath   As String
    Dim sheetName As String
    Dim rangeAddr As String

    rawPath   = Trim(Replace(CStr(checkerWs.Range("C2").Value), "/", "\"))
    sheetName = Trim(CStr(checkerWs.Range("C3").Value))
    rangeAddr = Trim(CStr(checkerWs.Range("C4").Value))

    If rawPath = "" Or sheetName = "" Or rangeAddr = "" Then
        MsgBox "Please fill in all three inputs:" & vbCrLf & _
               "  C2  - File path" & vbCrLf & _
               "  C3  - Sheet name" & vbCrLf & _
               "  C4  - Range (e.g. A3:B20)", vbExclamation
        Exit Sub
    End If

    If Dir(rawPath) = "" Then
        MsgBox "File not found:" & vbCrLf & rawPath, vbCritical
        Exit Sub
    End If

    Dim targetWb    As Workbook
    Dim alreadyOpen As Boolean
    alreadyOpen = False

    Dim wb As Workbook
    For Each wb In Application.Workbooks
        If LCase(wb.FullName) = LCase(rawPath) Then
            Set targetWb = wb
            alreadyOpen = True
            Exit For
        End If
    Next wb

    If Not alreadyOpen Then
        Set targetWb = Workbooks.Open(rawPath)
    End If

    Dim targetWs As Worksheet
    On Error Resume Next
    Set targetWs = targetWb.Sheets(sheetName)
    On Error GoTo 0

    If targetWs Is Nothing Then
        MsgBox "Sheet '" & sheetName & "' not found in:" & vbCrLf & rawPath, vbCritical
        If Not alreadyOpen Then targetWb.Close False
        Exit Sub
    End If

    Dim targetRange As Range
    On Error Resume Next
    Set targetRange = targetWs.Range(rangeAddr)
    On Error GoTo 0

    If targetRange Is Nothing Then
        MsgBox "Invalid range: " & rangeAddr, vbCritical
        If Not alreadyOpen Then targetWb.Close False
        Exit Sub
    End If

    Application.ScreenUpdating = False
    targetWb.Activate
    targetWs.Activate
    targetRange.Interior.ColorIndex = xlNone

    Dim cell       As Range
    Dim deps       As Range
    Dim noDep      As Long
    Dim cellCount  As Long
    Dim totalCells As Long
    totalCells = targetRange.Cells.Count

    For Each cell In targetRange.Cells
        cellCount = cellCount + 1
        Application.StatusBar = "Checking " & cellCount & " of " & totalCells & " (" & cell.Address(False, False) & ")"

        ' Range.Dependents is the direct equivalent of Trace Dependents.
        ' It errors if no dependents exist anywhere in the workbook.
        Set deps = Nothing
        On Error Resume Next
        Set deps = cell.Dependents
        On Error GoTo 0

        If deps Is Nothing Then
            cell.Interior.Color = RGB(255, 105, 105)
            noDep = noDep + 1
        End If
    Next cell

    Application.ScreenUpdating = True
    Application.StatusBar = False

    MsgBox "Done! " & noDep & " of " & totalCells & " cell(s) highlighted red (no dependents anywhere in the workbook).", vbInformation

End Sub
